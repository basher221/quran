{
  "name": "quran-mobile-app",
  "version": "1.0.0",
  "private": true,
  "description": "Quran web app packaged as Android app using Capacitor.",
  "scripts": {
    "build:web": "powershell -ExecutionPolicy Bypass -File ./prepare-mobile-web.ps1",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:open:android": "npx cap open android",
    "cap:add:android": "npx cap add android"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/core": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "latest"
  }
}
